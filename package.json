{
  "name": "saucedemo-playwright-framework",
  "version": "1.0.0",
  "description": "Playwright + TypeScript UI automation framework (Page Object Model, data-driven, fixtures, CI) for saucedemo.com",
  "scripts": {
    "test": "playwright test --project=chrome",
    "test:chromium": "playwright test --project=chromium",
    "test:headed": "playwright test --project=chrome --headed",
    "test:smoke": "playwright test --project=chrome --grep @smoke",
    "test:negative": "playwright test --project=chrome --grep @negative",
    "typecheck": "tsc --noEmit",
    "report": "playwright show-report",
    "test:all": "playwright test --project=chromium --project=firefox --project=webkit"
  },
  "keywords": [
    "playwright",
    "typescript",
    "automation",
    "page-object-model",
    "data-driven"
  ],
  "license": "ISC",
  "type": "commonjs",
  "devDependencies": {
    "@playwright/test": "^1.65.0",
    "@types/node": "^26.6.6",
    "typescript": "^5.6.0"
  }
}
